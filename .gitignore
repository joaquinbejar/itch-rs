# macOS
.DS_Store

# JetBrains IDEs
.idea/

# Cargo / Rust build output
/target
**/target

# Coverage output
/coverage
*.profraw

# Criterion + bench-hdr output
/target/criterion
/target/bench-hdr
*.hgrm

# Fuzz runtime state — `corpus/` accumulates inputs as the fuzzer
# explores; `artifacts/` holds crashing-input dumps. Both can grow
# unboundedly so they stay ignored. Seeds live separately under
# `fuzz/seeds/<target>/` and are copied into the corpus by the
# `fuzz` Make target / CI workflow before each run.
/fuzz/corpus/*/
!/fuzz/corpus/*/.gitkeep
/fuzz/artifacts

# proptest regressions are committed (per skill guidance) — do NOT ignore
# /proptest-regressions/    # intentionally NOT ignored

# Editor swap files
*.swp
*.swo

# Environment files (never commit credentials)
.env
.env.local
